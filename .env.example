# Copy to `.env` and adjust. Every variable here is also readable directly from the
# process environment (nothing in the code silently loads `.env` yet).

# --- where the config file lives (optional) -------------------------------------
TUTOR_CONFIG_PATH=./config.yaml

# --- config.yaml overrides (§19) ------------------------------------------------
# Pattern: LOCAL_TUTOR__<SECTION>__<KEY>
LOCAL_TUTOR__LLM__BASE_URL=http://127.0.0.1:8080
LOCAL_TUTOR__LLM__MODEL=qwen3.5-9b
LOCAL_TUTOR__LLM__TIMEOUT=180
LOCAL_TUTOR__TUTOR__DEFAULT_MODE=tutor
LOCAL_TUTOR__TUTOR__MAX_VERIFICATION_ATTEMPTS=2
LOCAL_TUTOR__MEMORY__RECENT_TURNS=30
LOCAL_TUTOR__RETRIEVAL__ENABLED=false
LOCAL_TUTOR__RETRIEVAL__TOP_K=6

# --- llama.cpp launch parameters (§5, used from Phase 1 on) ---------------------
# Fill these in on your machine; they are intentionally empty so that no absolute
# path is ever committed. scripts/start_llama.sh reads them.
LLAMA_SERVER_BIN=
LLAMA_MODEL_PATH=
LLAMA_MMPROJ_PATH=
